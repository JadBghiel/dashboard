# every var the app reads, w/ a working local value. npm run setup copies this to .env.local, which
# is gitignored, so real secrets never land in the repo

# postgres from docker-compose.dev.yml. the seed refuses any non local host bc its passwords are public
DATABASE_URL="postgresql://dashboard:dashboard@localhost:55433/dashboard"

# prod only, set by the neon integration on vercel: the direct url migrations run on, DATABASE_URL is
# the pooled one there. leave it unset locally, prisma falls back to DATABASE_URL
# DATABASE_URL_UNPOOLED=""

#better-auth, generate a real secret with "openssl rand -base64 32"
BETTER_AUTH_SECRET="dev-only-secret-change-me"
BETTER_AUTH_URL="http://localhost:3000"

# encrypts a user's own pasted api keys (credential table, #17). never share this value - anyone
# with it can decrypt every stored key. it must be 32 bytes in base64, the server refuses to start
# otherwise. generate one with: openssl rand -base64 32 (not -hex, that one is 64 characters)
CREDENTIALS_KEY=""

# mail, see lib/email.ts. empty SENDGRID_API_KEY = nodemailer -> mailpit (docker-compose.dev.yml),
# open http://localhost:8025 to read what the app sends. set it (prod) and sendgrid delivers for real,
# via its free single-sender verification (no domain needed): settings -> sender authentication ->
# verify a single sender, then settings -> api keys
SENDGRID_API_KEY=""
SMTP_HOST="localhost"
SMTP_PORT="1025"
# an email address. w/ sendgrid it must exactly match the verified sender
MAIL_FROM="dashboard@localhost"

# the db-test container. npm test wipes every table in it between files, so it must never point at
# the dev db
TEST_DATABASE_URL="postgresql://dashboard:dashboard@localhost:55434/dashboard_test"

# stock market widget. 1 free key for the whole app from finnhub.io, server side only. empty = the
# market card says "isn't configured", everything else still works
FINNHUB_API_KEY=""

# translator widget, optional. mymemory's free quota is 5000 characters a day per server, an email
# here raises it to 50000. its sent to mymemory as a contact on each request, nothing else
MYMEMORY_EMAIL=""

# google oauth, console.cloud.google.com -> APIs & Services -> Credentials. redirect uri must be
# registered there: {BETTER_AUTH_URL}/api/auth/callback/google (both local and prod urls)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
