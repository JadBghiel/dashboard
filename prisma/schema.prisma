// data model for the dash. better-auth owns user, session, account and verification, the rest is ours

// out of node_modules and gitignored, its regenerated on every npm install by the postinstall script
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- better-auth ----
// generated by `auth generate` (better-auth 1.7.5 w/ the username and admin plugins), the only hand
// edits are the back relations to our tables, rerun the cli in #7 and diff before touching these pls

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?
  displayUsername String?
  role            String?
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]

  credentials Credential[]
  widgets     WidgetInstance[]
  settings    UserSettings?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- ours ----
// service and widget ids are plain strings on purpose. the registry in code decides what
// exists (#14), a db enum would be a 2nd list to keep in sync every time a widget is added

// a users own api key, AES-256-GCM (#17). not readable back through the api obviosuly
model Credential {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId  String
  ciphertext Bytes
  iv         Bytes
  tag        Bytes
  // last 4 chars of the key, the only part the api ever sends back
  hint       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, serviceId])
  @@map("credential")
}

model WidgetInstance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId  String
  widgetId   String
  // parsed w/ the widget zod schema before every insert and update
  params     Json
  refreshSec Int
  // not unique on purpose, rewritted when reorder
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, position])
  @@map("widget_instance")
}

// the user's own settings, in the db so they follow the account on every device (mid term note).
// the widgets' own options live on WidgetInstance, this is what belongs to the user
model UserSettings {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // the city the user picked, null = not set, the ip guess or madrid then
  locationName    String?
  lat             Float?
  lon             Float?
  country         String?
  // gdpr: the ip guess is only used once the user said yes. null = not asked yet
  locationConsent Boolean?
  // small | normal | large
  textSize        String   @default("normal")
  // system | light | dark
  theme           String   @default("system")
  // the default widgets were given, so removing them all leaves an empty dashboard, not 16 new ones
  widgetsSeeded   Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@map("user_settings")
}

// the widget cache shared by every server copy, behind each copy's memory (server/widget-cache.ts).
// keyed by the widget + a hash of what its answer depends on (params, location, day), not by user,
// so the same config shares 1 row. expired rows are kept on purpose: the last good answer when the
// upstream is down
model CachedResponse {
  key       String   @id
  payload   Json
  expiresAt DateTime

  @@map("cached_response")
}
