// data model for the dash. better-auth owns user, session, account and verification, the rest is
// ours

// out of node_modules and gitignored, regenerated on every npm install by the postinstall script
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- better-auth ----
// generated by `auth generate` (better-auth 1.7.5 w/ the username and admin plugins). the only hand
// edits are the back relations to our tables, rerun the cli in #7 and diff before touching these

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?
  displayUsername String?
  role            String?
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]

  subscriptions ServiceSubscription[]
  credentials   Credential[]
  widgets       WidgetInstance[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  subscriptions ServiceSubscription[]

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- ours ----
// service, widget and size ids are plain strings on purpose. the registry in code decides what
// exists (#14), a db enum would be a 2nd list to keep in sync every time a widget is added

enum SubscriptionStatus {
  active
  needs_reauth
  revoked

  @@map("subscription_status")
}

model ServiceSubscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  status    SubscriptionStatus @default(active)
  // set for oauth services only, the tokens stay on the better-auth account row
  accountId String?
  account   Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, serviceId])
  // postgres doesnt index fk columns by itself, and unlinking an account scans this for SetNull
  @@index([accountId])
  @@map("service_subscription")
}

// a users own api key, AES-256-GCM (#17). never readable back through the api
model Credential {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId  String
  ciphertext Bytes
  iv         Bytes
  tag        Bytes
  // last 4 chars of the key, the only part the api ever sends back
  hint       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, serviceId])
  @@map("credential")
}

model WidgetInstance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId  String
  widgetId   String
  // parsed w/ the widget zod schema before every insert and update, never trusted as is
  params     Json
  refreshSec Int
  size       String
  // not unique on purpose, a reorder rewrites every position in 1 transaction and would collide
  // with itself half way through
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, position])
  @@map("widget_instance")
}

// L2 of the upstream cache, behind the in memory one. keyed by the widget params and not the
// instance, so 2 instances w/ the same config share 1 row. expired rows are kept on purpose, they
// are the last good payload served when the upstream is down
model CachedResponse {
  key       String   @id
  payload   Json
  expiresAt DateTime

  @@map("cached_response")
}

// cookie/crumb style state for keyless upstreams (yahoo), so a cold lambda reuses it instead of
// redoing the handshake on every request
model UpstreamSession {
  provider  String   @id
  blob      Json
  expiresAt DateTime

  @@map("upstream_session")
}
